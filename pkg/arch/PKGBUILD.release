# Maintainer xgui4 name@example.com
pkgname=hello-world-gtk
pkgver=0.0.0.2
pkgrel=1
pkgdesc="My First GTK App"
arch=('x86_64')
url="https://github.com/xgui4/hello-world-gtk"
license=('MIT') 
depends=(
  'gtk4'
  'glib2'
  'glibc'
  'xdg-utils'
  'pango'
  'cairo' 
  'harfbuzz' 
  'gdk-pixbuf2' 
  'graphene' 
  'vulkan-icd-loader'
  'json-glib'
)
makedepends=(
  'gcc'
  'clang'
  'make' 
  'pkgconfig' 
  'autoconf' 
  'automake' 
  'git'
)
source=('hello-world-gtk::git+https://github.com/xgui4/hello-world-gtk#tag=0.0.0.2' '../io.github.xgui4.hello.world.gtk.metainfo.xml')

sha256sums=('SKIP') # will have the check later 

build() {
  export CC=clang
  cd "${srcdir}/${pkgname}"
  meson setup build
  meson compile -C build
}

package() {
  install -Dm755 "${srcdir}/$pkgname/build/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm755 "${srcdir}/$pkgname/pkg/io.github.xgui4.hello.world.gtk.desktop" "$pkgdir/usr/share/applications/io.github.xgui4.hello.world.gtk.desktop"
  install -Dm644 "${srcdir}/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "${srcdir}/$pkgname/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "${srcdir}/$pkgname/code-of-conduct.md" "$pkgdir/usr/share/doc/$pkgname/code-of-conduct.md"
  install -Dm644 "${srcdir}/$pkgname/pkg/io.github.xgui4.hello.world.gtk.metainfo.xml" "$pkgdir/usr/share/metainfo/io.github.xgui4.hello.world.gtk.metainfo.xml"
}
